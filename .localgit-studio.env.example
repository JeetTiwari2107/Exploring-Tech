# Copy this file to .localgit-studio.env and set the bucket details below.
# LocalGit Studio never reads the existing .env file from the previous app.
# Use an AWS profile or the standard AWS credential provider chain for credentials.
LOCAL_GIT_PORT=3000
LOCAL_GIT_S3_BUCKET=
LOCAL_GIT_S3_REGION=us-east-1
LOCAL_GIT_S3_PREFIX=localgit-studio/backups
# Optional S3-compatible endpoint, such as http://127.0.0.1:9000
LOCAL_GIT_S3_ENDPOINT=
# Optional AWS shared credential profile name
AWS_PROFILE=
